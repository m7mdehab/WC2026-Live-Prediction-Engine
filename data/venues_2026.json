  "model_feature_notes": {
    "altitude_effect": "Mexico City (2240m) and Guadalajara (1566m) are the only meaningfully high-altitude venues. Effect on visiting teams from sea-level countries is real but quantifiable — academic literature suggests ~0.1 to 0.3 goal-difference effect per 1000m of altitude differential, modulated by acclimatization time.",
    "climate_effect": "Houston, Miami, Atlanta, Dallas in June-July are extreme heat/humidity environments. Open-air matches in these cities will affect physical performance; retractable-roof games less so.",
    "rest_and_travel": "16 venues × 4 timezones (PT through ET, plus Mexico CT). Travel distance and timezone-change feed into the model's rest/fatigue features for v1.1+. Use the lat/lng above to compute haversine distance.",
    "for_launch_model": "Use altitude_m and country (USA/Mexico/Canada) as features. Climate and roof_type defer to v1.2."
  }
